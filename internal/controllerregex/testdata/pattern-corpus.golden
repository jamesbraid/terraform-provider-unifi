# pattern-corpus.golden
#
# One JSON object per line (this header's '#' lines are not JSON and are
# skipped on read). Each line is one field the pinned SDK's constraint
# tables say the controller validates with a regular expression, and its
# accept ('A') / reject ('R') / error ('E') verdict over the fixed corpus
# below, compiled the way the generated schema actually compiles it --
# controllerregex.Compile, the controller's own dialect, not Go's RE2.
#
# Corpus, in verdict-string order:
#    0: ""
#    1: "\n"
#    2: "5\n"
#    3: "٣"
#    4: "3"
#    5: "café"
#    6: "cafe"
#    7: " "
#    8: "\t"
#    9: "a\rb"
#   10: "true"
#   11: "false"
#   12: "-1"
#   13: "0"
#   14: "192.168.1.1"
#   15: "aa:bb:cc:dd:ee:ff"
#   16: "AA:BB:CC:DD:EE:FF"
#   17: "example.com"
#   18: "-leadinghyphen.com"
#   19: "trailinghyphen-.com"
#   20: "a-real-key"
#   21: "!@#$%^&*()"
#   22: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
#   23: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
#   24: "axX25"
#   25: "ax:25"
#   26: "ax.25"
#
# Regenerate with: UPDATE_PATTERN_CORPUS=1 go test ./internal/controllerregex/ -run TestPatternCorpus
# Review the diff -- that review is what this file is for -- then commit it.
#
