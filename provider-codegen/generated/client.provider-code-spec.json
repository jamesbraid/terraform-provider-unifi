{
  "version": "0.1",
  "provider": {
    "name": "unifi"
  },
  "resources": [
    {
      "name": "client",
      "schema": {
        "attributes": [
          {
            "bool": {
              "computed_optional_required": "computed_optional",
              "default": {
                "static": true
              },
              "description": "Specifies whether this resource should just take over control of an existing client.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/boolplanmodifier"
                      }
                    ],
                    "schema_definition": "boolplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            },
            "name": "allow_existing"
          },
          {
            "bool": {
              "computed_optional_required": "computed_optional",
              "default": {
                "static": false
              },
              "description": "Specifies whether this client should be blocked from the network.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/boolplanmodifier"
                      }
                    ],
                    "schema_definition": "boolplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            },
            "name": "blocked"
          },
          {
            "name": "display_name",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "The display name of the client.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "fixed_ap_mac",
            "string": {
              "computed_optional_required": "computed_optional",
              "custom_type": {
                "import": {
                  "path": "github.com/hashicorp/terraform-plugin-framework-nettypes/hwtypes"
                },
                "type": "hwtypes.MACAddressType{}",
                "value_type": "hwtypes.MACAddress"
              },
              "description": "The MAC address of the access point to which this client should be fixed.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "fixed_ip",
            "string": {
              "computed_optional_required": "computed_optional",
              "custom_type": {
                "import": {
                  "path": "github.com/hashicorp/terraform-plugin-framework-nettypes/iptypes"
                },
                "type": "iptypes.IPv4AddressType{}",
                "value_type": "iptypes.IPv4Address"
              },
              "description": "A fixed IPv4 address for this client.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "list": {
              "computed_optional_required": "computed_optional",
              "description": "List of network members group names for this client.",
              "element_type": {
                "string": {}
              },
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/listplanmodifier"
                      }
                    ],
                    "schema_definition": "listplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            },
            "name": "groups"
          },
          {
            "name": "hostname",
            "string": {
              "computed_optional_required": "computed",
              "description": "The hostname of the client.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "id",
            "string": {
              "computed_optional_required": "computed",
              "description": "The ID of the client.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "last_ip",
            "string": {
              "computed_optional_required": "computed",
              "description": "The most recent IP address the controller has seen for this client (read-only).",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "local_dns_record",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "Specifies the local DNS record for this client.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "mac",
            "string": {
              "computed_optional_required": "required",
              "custom_type": {
                "import": {
                  "path": "github.com/hashicorp/terraform-plugin-framework-nettypes/hwtypes"
                },
                "type": "hwtypes.MACAddressType{}",
                "value_type": "hwtypes.MACAddress"
              },
              "description": "The MAC address of the client.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.RequiresReplace()"
                  }
                }
              ]
            }
          },
          {
            "name": "name",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "The name of the client.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "network_id",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "The network ID for this client.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "note",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "A note with additional information for the client.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "qos_rate",
            "single_nested": {
              "attributes": [
                {
                  "name": "id",
                  "string": {
                    "computed_optional_required": "computed_optional",
                    "description": "The ID of the client group (usergroup). If set, this group is used directly."
                  }
                },
                {
                  "int64": {
                    "computed_optional_required": "computed_optional",
                    "description": "Maximum download rate in kbps."
                  },
                  "name": "max_down"
                },
                {
                  "int64": {
                    "computed_optional_required": "computed_optional",
                    "description": "Maximum upload rate in kbps."
                  },
                  "name": "max_up"
                },
                {
                  "name": "name",
                  "string": {
                    "computed_optional_required": "computed_optional",
                    "description": "The name of the client group. If set, the group is looked up or created by name."
                  }
                }
              ],
              "computed_optional_required": "computed_optional",
              "description": "QoS rate limiting configuration. Controls the client group (usergroup) used for bandwidth limits.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/objectplanmodifier"
                      }
                    ],
                    "schema_definition": "objectplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "site",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "The name of the site to associate the client with.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.RequiresReplace()"
                  }
                },
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "bool": {
              "computed_optional_required": "computed_optional",
              "default": {
                "static": false
              },
              "description": "Specifies whether this resource should tell the controller to \"forget\" the client on destroy.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/boolplanmodifier"
                      }
                    ],
                    "schema_definition": "boolplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            },
            "name": "skip_forget_on_destroy"
          }
        ],
        "markdown_description": "Manages a client of the network, identified by unique MAC addresses.\n\nClients are created in the controller when observed on the network, so the resource defaults to allowing itself to just take over management of a MAC address, but this can be turned off."
      }
    }
  ]
}
