{
  "version": "0.1",
  "provider": {
    "name": "unifi"
  },
  "resources": [
    {
      "name": "vpn_server",
      "schema": {
        "attributes": [
          {
            "name": "dns",
            "single_nested": {
              "attributes": [
                {
                  "bool": {
                    "computed_optional_required": "computed_optional",
                    "description": "Specifies whether custom DNS servers are enabled for VPN clients. Defaults to `true` when `servers` is non-empty.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/boolplanmodifier"
                            }
                          ],
                          "schema_definition": "boolplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  },
                  "name": "enabled"
                },
                {
                  "list": {
                    "computed_optional_required": "optional",
                    "description": "DNS servers to push to VPN clients.",
                    "element_type": {
                      "string": {}
                    }
                  },
                  "name": "servers"
                }
              ],
              "computed_optional_required": "computed_optional",
              "description": "DNS configuration pushed to VPN clients.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/objectplanmodifier"
                      }
                    ],
                    "schema_definition": "objectplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "bool": {
              "computed_optional_required": "computed_optional",
              "default": {
                "static": true
              },
              "description": "Specifies whether the VPN server is enabled."
            },
            "name": "enabled"
          },
          {
            "name": "id",
            "string": {
              "computed_optional_required": "computed",
              "description": "The ID of the VPN server.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "l2tp",
            "single_nested": {
              "attributes": [
                {
                  "bool": {
                    "computed_optional_required": "computed_optional",
                    "default": {
                      "static": false
                    },
                    "description": "Allow weak ciphers for L2TP connections."
                  },
                  "name": "allow_weak_ciphers"
                },
                {
                  "name": "pre_shared_key",
                  "string": {
                    "computed_optional_required": "required",
                    "description": "IPsec pre-shared key for L2TP. Required by the UniFi controller.",
                    "sensitive": true
                  }
                }
              ],
              "computed_optional_required": "optional",
              "description": "L2TP VPN server configuration. Exactly one of `wireguard`, `l2tp`, or `openvpn` must be specified."
            }
          },
          {
            "name": "name",
            "string": {
              "computed_optional_required": "required",
              "description": "The name of the VPN server."
            }
          },
          {
            "name": "openvpn",
            "single_nested": {
              "attributes": [
                {
                  "name": "auth_key",
                  "string": {
                    "computed_optional_required": "computed",
                    "description": "OpenVPN static authentication key generated by the controller.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                            }
                          ],
                          "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ],
                    "sensitive": true
                  }
                },
                {
                  "name": "ca_crt",
                  "string": {
                    "computed_optional_required": "computed",
                    "description": "CA certificate generated by the controller.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                            }
                          ],
                          "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ],
                    "sensitive": true
                  }
                },
                {
                  "name": "ca_key",
                  "string": {
                    "computed_optional_required": "computed",
                    "description": "CA private key generated by the controller.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                            }
                          ],
                          "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ],
                    "sensitive": true
                  }
                },
                {
                  "name": "dh_key",
                  "string": {
                    "computed_optional_required": "computed",
                    "description": "Diffie-Hellman parameters generated by the controller.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                            }
                          ],
                          "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ],
                    "sensitive": true
                  }
                },
                {
                  "name": "encryption_cipher",
                  "string": {
                    "computed_optional_required": "computed_optional",
                    "default": {
                      "static": "AES_256_CBC"
                    },
                    "description": "Encryption cipher for OpenVPN. One of `AES_256_CBC` or `BF_CBC`.",
                    "validators": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                            }
                          ],
                          "schema_definition": "stringvalidator.OneOf(\"AES_256_CBC\", \"BF_CBC\")"
                        }
                      }
                    ]
                  }
                },
                {
                  "name": "mode",
                  "string": {
                    "computed_optional_required": "computed_optional",
                    "default": {
                      "static": "server"
                    },
                    "description": "OpenVPN mode.",
                    "validators": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                            }
                          ],
                          "schema_definition": "stringvalidator.OneOf(\"server\", \"site-to-site\")"
                        }
                      }
                    ]
                  }
                },
                {
                  "int64": {
                    "computed_optional_required": "computed_optional",
                    "default": {
                      "static": 1194
                    },
                    "description": "Port for the OpenVPN server to listen on.",
                    "validators": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework-validators/int64validator"
                            }
                          ],
                          "schema_definition": "int64validator.Between(1, 65535)"
                        }
                      }
                    ]
                  },
                  "name": "port"
                },
                {
                  "name": "server_crt",
                  "string": {
                    "computed_optional_required": "computed",
                    "description": "Server certificate generated by the controller.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                            }
                          ],
                          "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ],
                    "sensitive": true
                  }
                },
                {
                  "name": "server_key",
                  "string": {
                    "computed_optional_required": "computed",
                    "description": "Server private key generated by the controller.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                            }
                          ],
                          "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ],
                    "sensitive": true
                  }
                },
                {
                  "name": "shared_client_crt",
                  "string": {
                    "computed_optional_required": "computed",
                    "description": "Shared client certificate generated by the controller.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                            }
                          ],
                          "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ],
                    "sensitive": true
                  }
                },
                {
                  "name": "shared_client_key",
                  "string": {
                    "computed_optional_required": "computed",
                    "description": "Shared client private key generated by the controller.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                            }
                          ],
                          "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ],
                    "sensitive": true
                  }
                }
              ],
              "computed_optional_required": "optional",
              "description": "OpenVPN server configuration. Exactly one of `wireguard`, `l2tp`, or `openvpn` must be specified."
            }
          },
          {
            "name": "radiusprofile_id",
            "string": {
              "computed_optional_required": "optional",
              "description": "The ID of the RADIUS profile to use for authentication. Applicable to L2TP and OpenVPN server types."
            }
          },
          {
            "name": "site",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "The name of the site to associate the VPN server with.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.RequiresReplace()"
                  }
                },
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "subnet",
            "string": {
              "computed_optional_required": "required",
              "custom_type": {
                "import": {
                  "path": "github.com/hashicorp/terraform-plugin-framework-nettypes/cidrtypes"
                },
                "type": "cidrtypes.IPv4PrefixType{}",
                "value_type": "cidrtypes.IPv4Prefix"
              },
              "description": "The VPN server subnet in CIDR notation (e.g., `10.100.0.1/24`). The first address is the server's tunnel IP, so use the gateway form (`10.100.0.1/24`) \u2014 the network address (`10.100.0.0/24`) is rejected with `api.err.IncorrectIPSubnetSpec`."
            }
          },
          {
            "name": "wan",
            "single_nested": {
              "attributes": [
                {
                  "name": "interface",
                  "string": {
                    "computed_optional_required": "computed_optional",
                    "default": {
                      "static": "wan"
                    },
                    "description": "WAN interface to use for the VPN server (e.g., `wan`, `wan2`).",
                    "validators": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                            },
                            {
                              "path": "regexp"
                            }
                          ],
                          "schema_definition": "stringvalidator.RegexMatches(regexp.MustCompile(`^wan[2-9]?$`), \"must be 'wan' or 'wan2' through 'wan9'\")"
                        }
                      }
                    ]
                  }
                },
                {
                  "name": "ip",
                  "string": {
                    "computed_optional_required": "computed_optional",
                    "default": {
                      "static": "any"
                    },
                    "description": "Local WAN IP to bind the VPN server to. Use `any` to listen on all addresses."
                  }
                }
              ],
              "computed_optional_required": "computed_optional",
              "description": "WAN binding configuration for the VPN server.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/objectplanmodifier"
                      }
                    ],
                    "schema_definition": "objectplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "wireguard",
            "single_nested": {
              "attributes": [
                {
                  "int64": {
                    "computed_optional_required": "computed_optional",
                    "default": {
                      "static": 51820
                    },
                    "description": "UDP port for the WireGuard server to listen on.",
                    "validators": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework-validators/int64validator"
                            }
                          ],
                          "schema_definition": "int64validator.Between(1, 65535)"
                        }
                      }
                    ]
                  },
                  "name": "port"
                },
                {
                  "name": "private_key",
                  "string": {
                    "computed_optional_required": "computed_optional",
                    "description": "WireGuard private key for this server (base64). If not specified, the provider generates one at create time (the controller does not generate it and rejects a server without a key).",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                            }
                          ],
                          "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ],
                    "sensitive": true
                  }
                },
                {
                  "name": "public_key",
                  "string": {
                    "computed_optional_required": "computed",
                    "description": "WireGuard public key for this server. Computed from the private key.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                            }
                          ],
                          "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  }
                }
              ],
              "computed_optional_required": "optional",
              "description": "WireGuard VPN server configuration. Exactly one of `wireguard`, `l2tp`, or `openvpn` must be specified."
            }
          }
        ],
        "markdown_description": "`unifi_vpn_server` manages VPN server configurations (WireGuard, L2TP, or OpenVPN) in the UniFi controller."
      }
    }
  ]
}
