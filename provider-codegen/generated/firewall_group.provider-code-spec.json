{
  "version": "0.1",
  "provider": {
    "name": "unifi"
  },
  "resources": [
    {
      "name": "firewall_group",
      "schema": {
        "attributes": [
          {
            "name": "id",
            "string": {
              "computed_optional_required": "computed",
              "description": "The ID of the firewall group.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "members",
            "set": {
              "computed_optional_required": "required",
              "description": "The members of the firewall group.",
              "element_type": {
                "string": {}
              }
            }
          },
          {
            "name": "name",
            "string": {
              "computed_optional_required": "required",
              "description": "The name of the firewall group."
            }
          },
          {
            "name": "site",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "The name of the site to associate the firewall group with.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.RequiresReplace()"
                  }
                },
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "type",
            "string": {
              "computed_optional_required": "required",
              "description": "The type of the firewall group. Must be one of: `address-group`, `port-group`, or `ipv6-address-group`.",
              "validators": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                      }
                    ],
                    "schema_definition": "stringvalidator.OneOf(\"address-group\", \"port-group\", \"ipv6-address-group\")"
                  }
                }
              ]
            }
          }
        ],
        "markdown_description": "`unifi_firewall_group` manages groups of addresses or ports for use in firewall rules (`unifi_firewall_rule`)."
      }
    }
  ]
}
