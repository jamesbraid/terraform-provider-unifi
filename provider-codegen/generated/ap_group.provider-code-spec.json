{
  "version": "0.1",
  "provider": {
    "name": "unifi"
  },
  "resources": [
    {
      "name": "ap_group",
      "schema": {
        "attributes": [
          {
            "name": "device_macs",
            "set": {
              "computed_optional_required": "computed_optional",
              "description": "The MAC addresses of the access points that are members of the group. May be empty \u2014 the controller accepts a group with no members. Omit it to leave the membership as the controller has it.",
              "element_type": {
                "string": {
                  "custom_type": {
                    "import": {
                      "path": "github.com/hashicorp/terraform-plugin-framework-nettypes/hwtypes"
                    },
                    "type": "hwtypes.MACAddressType{}",
                    "value_type": "hwtypes.MACAddress"
                  }
                }
              },
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/ubiquiti-community/terraform-provider-unifi/unifi/planmodifiers"
                      }
                    ],
                    "schema_definition": "planmodifiers.KeepEquivalentMACs{}"
                  }
                },
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/setplanmodifier"
                      }
                    ],
                    "schema_definition": "setplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "id",
            "string": {
              "computed_optional_required": "computed",
              "description": "The ID of the AP group.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "name",
            "string": {
              "computed_optional_required": "required",
              "description": "The name of the AP group.",
              "validators": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                      }
                    ],
                    "schema_definition": "stringvalidator.LengthAtLeast(1)"
                  }
                }
              ]
            }
          },
          {
            "name": "site",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "The name of the site to associate the AP group with.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.RequiresReplace()"
                  }
                },
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          }
        ],
        "markdown_description": "`unifi_ap_group` manages a group of access points, which can be referenced from wireless networks (`unifi_wlan`) to control where an SSID is broadcast. The controller's built-in default group (\"All APs\") is read-only; updating or deleting it through this resource fails with a controller error."
      }
    }
  ]
}
