                    "name": "rx_bytes"
                  },
                  {
                    "int64": {
                      "computed_optional_required": "computed",
                      "description": "The receive rate in kbps."
                    },
                    "name": "rx_rate"
                  },
                  {
                    "int64": {
                      "computed_optional_required": "computed",
