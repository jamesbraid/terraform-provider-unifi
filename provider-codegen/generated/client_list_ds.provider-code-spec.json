                  },
                  {
                    "int64": {
                      "computed_optional_required": "computed",
                      "description": "The switch port number the client is connected to."
                    },
                    "name": "sw_port"
                  },
                  {
                    "int64": {
                      "computed_optional_required": "computed",
                      "description": "Total bytes transmitted."
                    },
                    "name": "tx_bytes"
                  },
                  {
                    "int64": {
                      "computed_optional_required": "computed",
                      "description": "The transmit rate in kbps."
                    },
                    "name": "tx_rate"
                  },
                  {
                    "int64": {
                      "computed_optional_required": "computed",
                      "description": "The uptime of the client in seconds."
                    },
                    "name": "uptime"
                  },
                  {
                    "int64": {
                      "computed_optional_required": "computed",
                      "description": "The wired connection rate in Mbps."
                    },
                    "name": "wired_rate_mbps"
                  }
                ]
              }
            },
            "name": "clients"
          },
          {
            "name": "group",
            "string": {
              "computed_optional_required": "optional",
              "description": "Filter clients by network members group name."
