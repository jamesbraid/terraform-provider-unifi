{
  "version": "0.1",
  "provider": {
    "name": "unifi"
  },
  "listresources": [
    {
      "name": "dynamic_dns",
      "schema": {
        "attributes": [
          {
            "name": "site",
            "string": {
              "computed_optional_required": "optional",
              "description": "The name of the site to list dynamic DNS configurations from."
            }
          }
        ],
        "blocks": [
          {
            "list_nested": {
              "nested_object": {
                "attributes": [
                  {
                    "name": "name",
                    "string": {
                      "computed_optional_required": "required",
                      "description": "The name of the filter to apply. Supported values are: `host_name`, `service`."
                    }
                  },
                  {
                    "name": "value",
                    "string": {
                      "computed_optional_required": "required",
                      "description": "The value to filter by."
                    }
                  }
                ]
              }
            },
            "name": "filter"
          }
        ],
        "markdown_description": "List dynamic DNS configurations in a site."
      }
    }
  ]
}
