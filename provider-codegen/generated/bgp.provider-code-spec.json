{
  "version": "0.1",
  "provider": {
    "name": "unifi"
  },
  "resources": [
    {
      "name": "bgp",
      "schema": {
        "attributes": [
          {
            "int64": {
              "computed_optional_required": "optional",
              "description": "The BGP Autonomous System Number. Conflicts with `config`.",
              "validators": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework-validators/int64validator"
                      },
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/path"
                      }
                    ],
                    "schema_definition": "int64validator.AlsoRequires(path.MatchRoot(\"router_id\"), path.MatchRoot(\"peers\"))"
                  }
                },
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework-validators/int64validator"
                      }
                    ],
                    "schema_definition": "int64validator.Between(1, 4294967295)"
                  }
                }
              ]
            },
            "name": "asn"
          },
          {
            "name": "config",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "The raw FRRouting BGP daemon configuration. Conflicts with `asn`, `router_id`, and `peers`.",
              "validators": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                      },
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/path"
                      }
                    ],
                    "schema_definition": "stringvalidator.ConflictsWith(path.MatchRoot(\"asn\"), path.MatchRoot(\"router_id\"), path.MatchRoot(\"peers\"))"
                  }
                }
              ]
            }
          },
          {
            "name": "description",
            "string": {
              "computed_optional_required": "computed_optional",
              "default": {
                "static": "BGP Configuration"
              },
              "description": "Description of the BGP configuration."
            }
          },
          {
            "bool": {
              "computed_optional_required": "computed_optional",
              "default": {
                "static": false
              },
              "description": "Enable BGP routing."
            },
            "name": "enabled"
          },
          {
            "name": "id",
            "string": {
              "computed_optional_required": "computed",
              "description": "The ID of the BGP configuration.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "list_nested": {
              "computed_optional_required": "optional",
              "description": "List of BGP peer groups. Conflicts with `config`.",
              "nested_object": {
                "attributes": [
                  {
                    "name": "name",
                    "string": {
                      "computed_optional_required": "required",
                      "description": "The peer group name."
                    }
                  },
                  {
                    "int64": {
                      "computed_optional_required": "required",
                      "description": "The remote Autonomous System Number for this peer group.",
                      "validators": [
                        {
                          "custom": {
                            "imports": [
                              {
                                "path": "github.com/hashicorp/terraform-plugin-framework-validators/int64validator"
                              }
                            ],
                            "schema_definition": "int64validator.Between(1, 4294967295)"
                          }
                        }
                      ]
                    },
                    "name": "remote_as"
                  },
                  {
                    "name": "description",
                    "string": {
                      "computed_optional_required": "optional",
                      "description": "Description of this peer group."
                    }
                  },
                  {
                    "list": {
                      "computed_optional_required": "optional",
                      "description": "List of network CIDR ranges to listen on for this peer group.",
                      "element_type": {
                        "string": {}
                      }
                    },
                    "name": "networks"
                  }
                ]
              }
            },
            "name": "peers"
          },
          {
            "name": "router_id",
            "string": {
              "computed_optional_required": "optional",
              "description": "The BGP router ID (typically an IP address). Conflicts with `config`.",
              "validators": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                      },
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/path"
                      }
                    ],
                    "schema_definition": "stringvalidator.AlsoRequires(path.MatchRoot(\"asn\"), path.MatchRoot(\"peers\"))"
                  }
                }
              ]
            }
          },
          {
            "name": "site",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "The name of the site to associate the BGP configuration with.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.RequiresReplace()"
                  }
                },
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "upload_file_name",
            "string": {
              "computed_optional_required": "computed_optional",
              "default": {
                "static": "frr.conf"
              },
              "description": "The name of the uploaded configuration file."
            }
          }
        ],
        "markdown_description": "Manages BGP configuration for the UniFi Controller. Configuration can be provided either as a raw FRR config string via `config`, or via structured attributes (`asn`, `router_id`, `peers`) which render a config from a template."
      }
    }
  ]
}
