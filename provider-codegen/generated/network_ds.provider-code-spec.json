{
  "version": "0.1",
  "provider": {
    "name": "unifi"
  },
  "datasources": [
    {
      "name": "network_ds",
      "schema": {
        "attributes": [
          {
            "bool": {
              "computed_optional_required": "computed",
              "description": "Specifies whether auto-scaling is enabled."
            },
            "name": "auto_scale"
          },
          {
            "name": "dhcp_guarding",
            "single_nested": {
              "attributes": [
                {
                  "bool": {
                    "computed_optional_required": "computed",
                    "description": "Specifies whether DHCP guarding is enabled."
                  },
                  "name": "enabled"
                },
                {
                  "list": {
                    "computed_optional_required": "computed",
                    "description": "List of allowed DHCP server IP addresses.",
                    "element_type": {
                      "string": {}
                    }
                  },
                  "name": "servers"
                }
              ],
              "computed_optional_required": "computed",
              "description": "DHCP guarding configuration."
            }
          },
          {
            "name": "dhcp_relay",
            "single_nested": {
              "attributes": [
                {
                  "bool": {
                    "computed_optional_required": "computed",
                    "description": "Specifies whether DHCP relay is enabled."
                  },
                  "name": "enabled"
                },
                {
                  "list": {
                    "computed_optional_required": "computed",
                    "description": "List of DHCP relay server addresses.",
                    "element_type": {
                      "string": {}
                    }
                  },
                  "name": "servers"
                }
              ],
              "computed_optional_required": "computed",
              "description": "DHCP relay configuration."
            }
          },
          {
            "name": "dhcp_server",
            "single_nested": {
              "attributes": [
                {
                  "name": "boot",
                  "single_nested": {
                    "attributes": [
                      {
                        "bool": {
                          "computed_optional_required": "computed",
                          "description": "Toggles DHCP boot options."
                        },
                        "name": "enabled"
                      },
                      {
                        "name": "server",
                        "string": {
                          "computed_optional_required": "computed",
                          "description": "TFTP server for boot options."
                        }
                      },
                      {
                        "name": "filename",
                        "string": {
                          "computed_optional_required": "computed",
                          "description": "Boot filename."
                        }
                      }
                    ],
                    "computed_optional_required": "computed",
                    "description": "DHCP boot settings."
                  }
                },
                {
                  "bool": {
                    "computed_optional_required": "computed",
                    "description": "Specifies whether DHCP conflict checking is enabled."
                  },
                  "name": "conflict_checking"
                },
                {
                  "bool": {
                    "computed_optional_required": "computed",
                    "description": "Specifies whether DHCP DNS is enabled."
                  },
                  "name": "dns_enabled"
                },
                {
                  "list": {
                    "computed_optional_required": "computed",
                    "description": "List of DNS server addresses for DHCP clients.",
                    "element_type": {
                      "string": {}
                    }
                  },
                  "name": "dns_servers"
                },
                {
                  "bool": {
                    "computed_optional_required": "computed",
                    "description": "Specifies whether DHCP server is enabled."
                  },
                  "name": "enabled"
                },
                {
                  "bool": {
                    "computed_optional_required": "computed",
                    "description": "Specifies whether DHCP gateway is enabled."
                  },
                  "name": "gateway_enabled"
                },
                {
                  "name": "leasetime",
                  "string": {
                    "computed_optional_required": "computed",
                    "custom_type": {
                      "import": {
                        "path": "github.com/hashicorp/terraform-plugin-framework-timetypes/timetypes"
                      },
                      "type": "timetypes.GoDurationType{}",
                      "value_type": "timetypes.GoDuration"
                    },
                    "description": "Specifies the DHCP lease time, as a Go duration string."
                  }
                },
                {
                  "bool": {
                    "computed_optional_required": "computed",
                    "description": "Specifies whether DHCP NTP is enabled."
                  },
                  "name": "ntp_enabled"
                },
                {
                  "name": "start",
                  "string": {
                    "computed_optional_required": "computed",
                    "description": "The IPv4 address where the DHCP range starts."
                  }
                },
                {
                  "name": "stop",
                  "string": {
                    "computed_optional_required": "computed",
                    "description": "The IPv4 address where the DHCP range stops."
                  }
                },
                {
                  "name": "tftp_server",
                  "string": {
                    "computed_optional_required": "computed",
                    "description": "TFTP server address."
                  }
                },
                {
                  "bool": {
                    "computed_optional_required": "computed",
                    "description": "Specifies whether DHCP time offset is enabled."
                  },
                  "name": "time_offset_enabled"
                },
                {
                  "name": "unifi_controller",
                  "string": {
                    "computed_optional_required": "computed",
                    "description": "UniFi controller IP address."
                  }
                },
                {
                  "name": "wins",
                  "single_nested": {
                    "attributes": [
                      {
                        "bool": {
                          "computed_optional_required": "computed",
                          "description": "Specifies whether DHCP WINS is enabled."
                        },
                        "name": "enabled"
                      },
                      {
                        "list": {
                          "computed_optional_required": "computed",
                          "description": "List of WINS server addresses.",
                          "element_type": {
                            "string": {}
                          }
                        },
                        "name": "addresses"
                      }
                    ],
                    "computed_optional_required": "computed",
                    "description": "WINS server configuration."
                  }
                },
                {
                  "name": "wpad_url",
                  "string": {
                    "computed_optional_required": "computed",
                    "description": "WPAD URL for proxy auto-configuration."
                  }
                }
              ],
              "computed_optional_required": "computed",
              "description": "DHCP server configuration."
            }
          },
          {
            "name": "dhcp_v6_server",
            "single_nested": {
              "attributes": [
                {
                  "bool": {
                    "computed_optional_required": "computed",
                    "description": "When true, upstream DNS entries are propagated. When false, `dns_servers` are used."
                  },
                  "name": "dns_auto"
                },
                {
                  "list": {
                    "computed_optional_required": "computed",
                    "description": "IPv6 DNS server addresses for DHCPv6 clients.",
                    "element_type": {
                      "string": {}
                    }
                  },
                  "name": "dns_servers"
                },
                {
                  "bool": {
                    "computed_optional_required": "computed",
                    "description": "Specifies whether stateful DHCPv6 is enabled."
                  },
                  "name": "enabled"
                },
                {
                  "int64": {
                    "computed_optional_required": "computed",
                    "description": "Lease time for DHCPv6 addresses in seconds."
                  },
                  "name": "lease"
                },
                {
                  "name": "start",
                  "string": {
                    "computed_optional_required": "computed",
                    "description": "Start address of the DHCPv6 range."
                  }
                },
                {
                  "name": "stop",
                  "string": {
                    "computed_optional_required": "computed",
                    "description": "End address of the DHCPv6 range."
                  }
                }
              ],
              "computed_optional_required": "computed",
              "description": "DHCPv6 server configuration."
            }
          },
          {
            "name": "domain_name",
            "string": {
              "computed_optional_required": "computed",
              "description": "The domain name for the network."
            }
          },
          {
            "bool": {
              "computed_optional_required": "computed",
              "description": "Specifies whether the network is enabled."
            },
            "name": "enabled"
          },
          {
            "name": "gateway_type",
            "string": {
              "computed_optional_required": "computed",
              "description": "The gateway type."
            }
          },
          {
            "name": "id",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "The ID of the network.",
              "validators": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                      },
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/path"
                      }
                    ],
                    "schema_definition": "stringvalidator.ConflictsWith(path.Expressions{path.MatchRoot(\"name\")}...)"
                  }
                }
              ]
            }
          },
          {
            "bool": {
              "computed_optional_required": "computed",
              "description": "Specifies whether IGMP snooping is enabled."
            },
            "name": "igmp_snooping"
          },
          {
            "bool": {
              "computed_optional_required": "computed",
              "description": "Specifies whether internet access is enabled."
            },
            "name": "internet_access"
          },
          {
            "list": {
              "computed_optional_required": "computed",
              "description": "List of IP aliases for the network.",
              "element_type": {
                "string": {}
              }
            },
            "name": "ip_aliases"
          },
          {
            "list": {
              "computed_optional_required": "computed",
              "description": "List of IPv6 aliases for the network.",
              "element_type": {
                "string": {}
              }
            },
            "name": "ipv6_aliases"
          },
          {
            "name": "ipv6_interface_type",
            "string": {
              "computed_optional_required": "computed",
              "description": "Specifies which type of IPv6 connection to use."
            }
          },
          {
            "name": "ipv6_pd_interface",
            "string": {
              "computed_optional_required": "computed",
              "description": "Specifies which WAN interface to use for IPv6 PD. One of `wan` or `wan2`."
            }
          },
          {
            "name": "ipv6_pd_prefixid",
            "string": {
              "computed_optional_required": "computed",
              "description": "Specifies the IPv6 Prefix ID."
            }
          },
          {
            "name": "ipv6_pd_start",
            "string": {
              "computed_optional_required": "computed",
              "description": "Start address of the DHCPv6 range when `ipv6_interface_type` is `pd`."
            }
          },
          {
            "name": "ipv6_pd_stop",
            "string": {
              "computed_optional_required": "computed",
              "description": "End address of the DHCPv6 range when `ipv6_interface_type` is `pd`."
            }
          },
          {
            "bool": {
              "computed_optional_required": "computed",
              "description": "Specifies whether to enable IPv6 router advertisements."
            },
            "name": "ipv6_ra"
          },
          {
            "name": "ipv6_ra_preferred_lifetime",
            "string": {
              "computed_optional_required": "computed",
              "custom_type": {
                "import": {
                  "path": "github.com/hashicorp/terraform-plugin-framework-timetypes/timetypes"
                },
                "type": "timetypes.GoDurationType{}",
                "value_type": "timetypes.GoDuration"
              },
              "description": "Preferred lifetime for IPv6 RA, as a Go duration string."
            }
          },
          {
            "name": "ipv6_ra_priority",
            "string": {
              "computed_optional_required": "computed",
              "description": "IPv6 router advertisement priority. One of `high`, `medium`, or `low`."
            }
          },
          {
            "name": "ipv6_ra_valid_lifetime",
            "string": {
              "computed_optional_required": "computed",
              "custom_type": {
                "import": {
                  "path": "github.com/hashicorp/terraform-plugin-framework-timetypes/timetypes"
                },
                "type": "timetypes.GoDurationType{}",
                "value_type": "timetypes.GoDuration"
              },
              "description": "Total lifetime for the IPv6 RA address, as a Go duration string."
            }
          },
          {
            "name": "ipv6_static_subnet",
            "string": {
              "computed_optional_required": "computed",
              "description": "The static IPv6 subnet (when `ipv6_interface_type` is `static`)."
            }
          },
          {
            "bool": {
              "computed_optional_required": "computed",
              "description": "Specifies whether LTE LAN is enabled."
            },
            "name": "lte_lan"
          },
          {
            "bool": {
              "computed_optional_required": "computed",
              "description": "Specifies whether mDNS is enabled."
            },
            "name": "multicast_dns"
          },
          {
            "name": "name",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "The name of the network.",
              "validators": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                      },
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/path"
                      }
                    ],
                    "schema_definition": "stringvalidator.ConflictsWith(path.Expressions{path.MatchRoot(\"id\")}...)"
                  }
                }
              ]
            }
          },
          {
            "list_nested": {
              "computed_optional_required": "computed",
              "description": "List of NAT outbound IP addresses.",
              "nested_object": {
                "attributes": [
                  {
                    "name": "ip_address",
                    "string": {
                      "computed_optional_required": "computed",
                      "description": "The IP address."
                    }
                  },
                  {
                    "list": {
                      "computed_optional_required": "computed",
                      "description": "The IP address pool.",
                      "element_type": {
                        "string": {}
                      }
                    },
                    "name": "ip_address_pool"
                  },
                  {
                    "name": "mode",
                    "string": {
                      "computed_optional_required": "computed",
                      "description": "The mode."
                    }
                  },
                  {
                    "name": "wan_network_group",
                    "string": {
                      "computed_optional_required": "computed",
                      "description": "The WAN network group."
                    }
                  }
                ]
              }
            },
            "name": "nat_outbound_ip_addresses"
          },
          {
            "name": "network_group",
            "string": {
              "computed_optional_required": "computed",
              "description": "The group of the network."
            }
          },
          {
            "bool": {
              "computed_optional_required": "computed",
              "description": "Specifies whether network isolation is enabled."
            },
            "name": "network_isolation"
          },
          {
            "name": "purpose",
            "string": {
              "computed_optional_required": "computed",
              "description": "The purpose of the network. One of `corporate`, `guest`, `wan`, or `vlan-only`."
            }
          },
          {
            "name": "setting_preference",
            "string": {
              "computed_optional_required": "computed",
              "description": "Setting preference. One of `auto` or `manual`."
            }
          },
          {
            "name": "site",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "The name of the site to associate the network with."
            }
          },
          {
            "name": "subnet",
            "string": {
              "computed_optional_required": "computed",
              "description": "The IP subnet of the network in CIDR notation."
            }
          },
          {
            "bool": {
              "computed_optional_required": "computed",
              "description": "Specifies whether this network uses a third-party gateway."
            },
            "name": "third_party_gateway"
          },
          {
            "int64": {
              "computed_optional_required": "computed",
              "description": "The VLAN ID for the network."
            },
            "name": "vlan"
          },
          {
            "list": {
              "computed_optional_required": "computed",
              "description": "DNS server IPs of the WAN.",
              "element_type": {
                "string": {}
              }
            },
            "name": "wan_dns"
          },
          {
            "int64": {
              "computed_optional_required": "computed",
              "description": "Specifies the WAN egress quality of service."
            },
            "name": "wan_egress_qos"
          },
          {
            "name": "wan_gateway",
            "string": {
              "computed_optional_required": "computed",
              "description": "The IPv4 gateway of the WAN."
            }
          },
          {
            "name": "wan_gateway_v6",
            "string": {
              "computed_optional_required": "computed",
              "description": "The IPv6 gateway of the WAN."
            }
          },
          {
            "name": "wan_ip",
            "string": {
              "computed_optional_required": "computed",
              "description": "The IPv4 address of the WAN."
            }
          },
          {
            "name": "wan_netmask",
            "string": {
              "computed_optional_required": "computed",
              "description": "The IPv4 netmask of the WAN."
            }
          },
          {
            "name": "wan_network_group",
            "string": {
              "computed_optional_required": "computed",
              "description": "Specifies the WAN network group. One of `WAN`, `WAN2` or `WAN_LTE_FAILOVER`."
            }
          },
          {
            "name": "wan_type",
            "string": {
              "computed_optional_required": "computed",
              "description": "Specifies the IPv4 WAN connection type. One of `disabled`, `static`, `dhcp`, or `pppoe`."
            }
          },
          {
            "name": "wan_type_v6",
            "string": {
              "computed_optional_required": "computed",
              "description": "Specifies the IPv6 WAN connection type. One of `disabled`, `static`, or `dhcpv6`."
            }
          },
          {
            "name": "wan_username",
            "string": {
              "computed_optional_required": "computed",
              "description": "Specifies the IPv4 WAN username."
            }
          }
        ],
        "markdown_description": "`unifi_network` data source can be used to retrieve settings for a network by name or ID."
      }
    }
  ]
}
