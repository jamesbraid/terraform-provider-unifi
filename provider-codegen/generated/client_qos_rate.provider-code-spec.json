{
  "version": "0.1",
  "provider": {
    "name": "unifi"
  },
  "resources": [
    {
      "name": "client_qos_rate",
      "schema": {
        "attributes": [
          {
            "name": "id",
            "string": {
              "computed_optional_required": "computed",
              "description": "The ID of the client QOS rate.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "name",
            "string": {
              "computed_optional_required": "required",
              "description": "The name of the client QOS rate."
            }
          },
          {
            "int64": {
              "computed_optional_required": "computed_optional",
              "default": {
                "static": -1
              },
              "description": "The QOS maximum download rate.",
              "validators": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework-validators/int64validator"
                      }
                    ],
                    "schema_definition": "int64validator.Between(2, 100000)"
                  }
                }
              ]
            },
            "name": "qos_rate_max_down"
          },
          {
            "int64": {
              "computed_optional_required": "computed_optional",
              "default": {
                "static": -1
              },
              "description": "The QOS maximum upload rate.",
              "validators": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework-validators/int64validator"
                      }
                    ],
                    "schema_definition": "int64validator.Between(2, 100000)"
                  }
                }
              ]
            },
            "name": "qos_rate_max_up"
          },
          {
            "name": "site",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "The name of the site to associate the client QOS rate with.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.RequiresReplace()"
                  }
                },
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          }
        ],
        "markdown_description": "Manages a client QOS rate, which can be used to limit bandwidth for groups of clients."
      }
    }
  ]
}
