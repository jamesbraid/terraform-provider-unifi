{
  "version": "0.1",
  "provider": {
    "name": "unifi"
  },
  "resources": [
    {
      "name": "firewall_policy",
      "schema": {
        "attributes": [
          {
            "name": "action",
            "string": {
              "computed_optional_required": "required",
              "description": "The action to take when the policy matches: `ALLOW`, `BLOCK`, or `REJECT`.",
              "validators": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                      }
                    ],
                    "schema_definition": "stringvalidator.OneOf(\"ALLOW\", \"BLOCK\", \"REJECT\")"
                  }
                }
              ]
            }
          },
          {
            "name": "connection_state_type",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "Connection-state matching mode: `ALL` (any state), `RESPOND_ONLY` (established/related returns), or `CUSTOM` (match the states listed in `connection_states`). Optional: if omitted the controller assigns it (defaults to `ALL`) and the provider round-trips the value so updates are accepted.",
              "validators": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                      }
                    ],
                    "schema_definition": "stringvalidator.OneOf(\"ALL\", \"RESPOND_ONLY\", \"CUSTOM\")"
                  }
                }
              ],
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "list": {
              "computed_optional_required": "computed_optional",
              "description": "Connection states matched when `connection_state_type` is `CUSTOM` (`NEW`, `ESTABLISHED`, `RELATED`, `INVALID`). Optional: leave unset for `ALL`/`RESPOND_ONLY` and the controller manages it; the provider round-trips the value so a `CUSTOM` policy's states are not dropped on update (which the firmware rejects with HTTP 400).",
              "element_type": {
                "string": {}
              },
              "validators": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework-validators/listvalidator"
                      },
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                      }
                    ],
                    "schema_definition": "listvalidator.ValueStringsAre(stringvalidator.OneOf(\"NEW\", \"ESTABLISHED\", \"RELATED\", \"INVALID\"))"
                  }
                }
              ],
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/listplanmodifier"
                      }
                    ],
                    "schema_definition": "listplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            },
            "name": "connection_states"
          },
          {
            "bool": {
              "computed_optional_required": "computed_optional",
              "description": "When `true`, UniFi automatically creates a matching rule to allow established/related return traffic. Recommended for `ALLOW` policies. Defaults to `false`.",
              "default": {
                "static": false
              }
            },
            "name": "create_allow_respond"
          },
          {
            "name": "description",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "A description for the policy.",
              "default": {
                "static": ""
              }
            }
          },
          {
            "name": "destination",
            "single_nested": {
              "attributes": [
                {
                  "list": {
                    "computed_optional_required": "computed_optional",
                    "description": "List of client MAC addresses to match. Used when `matching_target` is `CLIENT`.",
                    "element_type": {
                      "string": {}
                    },
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/listplanmodifier"
                            }
                          ],
                          "schema_definition": "listplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  },
                  "name": "client_macs"
                },
                {
                  "name": "ip_group_id",
                  "string": {
                    "computed_optional_required": "computed_optional",
                    "description": "ID of a `unifi_firewall_group` (address-group type) to match. Used when `matching_target` is `IP` with `matching_target_type = OBJECT`.",
                    "default": {
                      "static": ""
                    }
                  }
                },
                {
                  "list": {
                    "computed_optional_required": "computed_optional",
                    "description": "List of IP addresses or CIDR ranges to match. Used when `matching_target` is `IP`.",
                    "element_type": {
                      "string": {}
                    },
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/listplanmodifier"
                            }
                          ],
                          "schema_definition": "listplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  },
                  "name": "ips"
                },
                {
                  "bool": {
                    "computed_optional_required": "computed_optional",
                    "description": "Match on the endpoint's MAC address rather than its network identity. Meaningful only when `matching_target` selects a client; an inversion or match flag with nothing to act on is reported as false by the controller.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/boolplanmodifier"
                            }
                          ],
                          "schema_definition": "boolplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  },
                  "name": "match_mac"
                },
                {
                  "bool": {
                    "computed_optional_required": "computed_optional",
                    "description": "INVERT the IP match: the policy matches every address EXCEPT those in `ips` or `ip_group_id`. Meaningful only when `matching_target` is `IP`. Leave unset to keep whatever the controller holds -- setting it wrong reverses the rule rather than disabling it.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/boolplanmodifier"
                            }
                          ],
                          "schema_definition": "boolplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  },
                  "name": "match_opposite_ips"
                },
                {
                  "bool": {
                    "computed_optional_required": "computed_optional",
                    "description": "INVERT the network match: the policy matches every network EXCEPT those in `network_ids`. Meaningful only when `matching_target` selects networks.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/boolplanmodifier"
                            }
                          ],
                          "schema_definition": "boolplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  },
                  "name": "match_opposite_networks"
                },
                {
                  "bool": {
                    "computed_optional_required": "computed_optional",
                    "description": "INVERT the port match: the policy matches every port EXCEPT those in `port` or `port_group_id`. Meaningful only when `port_matching_type` selects specific ports.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/boolplanmodifier"
                            }
                          ],
                          "schema_definition": "boolplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  },
                  "name": "match_opposite_ports"
                },
                {
                  "name": "matching_target",
                  "string": {
                    "computed_optional_required": "required",
                    "description": "What to match: `ANY`, `NETWORK`, `CLIENT`, `IP`, `DEVICE`, `MAC`, or `WEB` (domains/FQDN).",
                    "validators": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                            }
                          ],
                          "schema_definition": "stringvalidator.OneOf(\"ANY\", \"NETWORK\", \"CLIENT\", \"IP\", \"DEVICE\", \"MAC\", \"WEB\")"
                        }
                      }
                    ]
                  }
                },
                {
                  "name": "matching_target_type",
                  "string": {
                    "computed_optional_required": "computed",
                    "description": "How the matching target is specified (`ANY`, `SPECIFIC`, `LIST`, `OBJECT`). Managed by the UniFi controller; the provider round-trips it so updates are accepted.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                            }
                          ],
                          "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  }
                },
                {
                  "list": {
                    "computed_optional_required": "computed_optional",
                    "description": "List of UniFi network IDs to match. Used when `matching_target` is `NETWORK`.",
                    "element_type": {
                      "string": {}
                    },
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/listplanmodifier"
                            }
                          ],
                          "schema_definition": "listplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  },
                  "name": "network_ids"
                },
                {
                  "name": "port",
                  "string": {
                    "computed_optional_required": "computed_optional",
                    "description": "Port(s) to match when `port_matching_type` is `SPECIFIC`. A single port (`161`) or a comma-separated list of ports/ranges (`80,443`, `8000-8100`). Leave unset for no port match.",
                    "validators": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "regexp"
                            },
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                            }
                          ],
                          "schema_definition": "stringvalidator.RegexMatches(regexp.MustCompile(`^[0-9]{1,5}(-[0-9]{1,5})?(,[0-9]{1,5}(-[0-9]{1,5})?)*$`), \"must be a port number or a comma-separated list of ports/ranges (e.g. \\\"80,443\\\" or \\\"8000-8100\\\")\")"
                        }
                      }
                    ],
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                            }
                          ],
                          "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  }
                },
                {
                  "name": "port_group_id",
                  "string": {
                    "computed_optional_required": "computed_optional",
                    "description": "ID of a `unifi_firewall_group` (port-group type) to match. Used when `port_matching_type` is `OBJECT`.",
                    "default": {
                      "static": ""
                    }
                  }
                },
                {
                  "name": "port_matching_type",
                  "string": {
                    "computed_optional_required": "computed_optional",
                    "description": "How to match ports: `ANY`, `SPECIFIC`, or `OBJECT` (port group).",
                    "validators": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                            }
                          ],
                          "schema_definition": "stringvalidator.OneOf(\"ANY\", \"SPECIFIC\", \"OBJECT\")"
                        }
                      }
                    ],
                    "default": {
                      "static": "ANY"
                    }
                  }
                },
                {
                  "list": {
                    "computed_optional_required": "computed_optional",
                    "description": "List of domains/FQDNs to match. Used when `matching_target` is `WEB`.",
                    "element_type": {
                      "string": {}
                    },
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/listplanmodifier"
                            }
                          ],
                          "schema_definition": "listplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  },
                  "name": "web_domains"
                },
                {
                  "name": "zone_id",
                  "string": {
                    "computed_optional_required": "required",
                    "description": "The ID of the firewall zone this endpoint belongs to. Use the `unifi_firewall_zone` data source to look up zone IDs by name."
                  }
                }
              ],
              "computed_optional_required": "required",
              "description": "The destination endpoint of the policy."
            }
          },
          {
            "bool": {
              "computed_optional_required": "computed_optional",
              "description": "Whether the policy is enabled. Defaults to `true`.",
              "default": {
                "static": true
              }
            },
            "name": "enabled"
          },
          {
            "name": "icmp_typename",
            "string": {
              "computed_optional_required": "computed",
              "description": "ICMP type matching mode. Managed by the UniFi controller; the provider round-trips it so updates are accepted.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "icmp_v6_typename",
            "string": {
              "computed_optional_required": "computed",
              "description": "ICMPv6 type matching mode. Managed by the UniFi controller; the provider round-trips it so updates are accepted.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "id",
            "string": {
              "computed_optional_required": "computed",
              "description": "The ID of the firewall policy.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "int64": {
              "computed_optional_required": "computed",
              "description": "The ordering index of the policy within its zone-pair, assigned by the controller. **Read-only:** UniFi does not accept a client-supplied index on create or update (the policy is always appended to the end of its source/destination zone-pair), and the supported API exposes no reorder operation, so policy ordering cannot be managed through this provider. Reorder policies in the UniFi UI if needed.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/int64planmodifier"
                      }
                    ],
                    "schema_definition": "int64planmodifier.UseStateForUnknown()"
                  }
                }
              ]
            },
            "name": "index"
          },
          {
            "name": "ip_version",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "The IP version to match: `BOTH`, `IPV4`, or `IPV6`. Defaults to `IPV4`.",
              "validators": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                      }
                    ],
                    "schema_definition": "stringvalidator.OneOf(\"BOTH\", \"IPV4\", \"IPV6\")"
                  }
                }
              ],
              "default": {
                "static": "IPV4"
              }
            }
          },
          {
            "bool": {
              "computed_optional_required": "computed_optional",
              "description": "Whether to log packets matching this policy. Defaults to `false`.",
              "default": {
                "static": false
              }
            },
            "name": "logging"
          },
          {
            "name": "name",
            "string": {
              "computed_optional_required": "required",
              "description": "The name of the firewall policy."
            }
          },
          {
            "name": "protocol",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "The protocol to match: `all`, `tcp`, `udp`, `tcp_udp`, `icmp`, or `icmpv6`. Defaults to `all`. Note: for `icmp`/`icmpv6` policies the controller rejects `create_allow_respond = true` (`FirewallPolicyCreateRespondTrafficPolicyNotAllowed`) \u2014 keep it `false` and add an explicit reverse policy if you need the reply.",
              "validators": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                      }
                    ],
                    "schema_definition": "stringvalidator.OneOf(\"all\", \"tcp\", \"udp\", \"tcp_udp\", \"icmp\", \"icmpv6\")"
                  }
                }
              ],
              "default": {
                "static": "all"
              }
            }
          },
          {
            "name": "site",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "The name of the UniFi site. Defaults to the site configured in the provider.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "source",
            "single_nested": {
              "attributes": [
                {
                  "list": {
                    "computed_optional_required": "computed_optional",
                    "description": "List of client MAC addresses to match. Used when `matching_target` is `CLIENT`.",
                    "element_type": {
                      "string": {}
                    },
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/listplanmodifier"
                            }
                          ],
                          "schema_definition": "listplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  },
                  "name": "client_macs"
                },
                {
                  "name": "ip_group_id",
                  "string": {
                    "computed_optional_required": "computed_optional",
                    "description": "ID of a `unifi_firewall_group` (address-group type) to match. Used when `matching_target` is `IP` with `matching_target_type = OBJECT`.",
                    "default": {
                      "static": ""
                    }
                  }
                },
                {
                  "list": {
                    "computed_optional_required": "computed_optional",
                    "description": "List of IP addresses or CIDR ranges to match. Used when `matching_target` is `IP`.",
                    "element_type": {
                      "string": {}
                    },
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/listplanmodifier"
                            }
                          ],
                          "schema_definition": "listplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  },
                  "name": "ips"
                },
                {
                  "bool": {
                    "computed_optional_required": "computed_optional",
                    "description": "Match on the endpoint's MAC address rather than its network identity. Meaningful only when `matching_target` selects a client; an inversion or match flag with nothing to act on is reported as false by the controller.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/boolplanmodifier"
                            }
                          ],
                          "schema_definition": "boolplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  },
                  "name": "match_mac"
                },
                {
                  "bool": {
                    "computed_optional_required": "computed_optional",
                    "description": "INVERT the IP match: the policy matches every address EXCEPT those in `ips` or `ip_group_id`. Meaningful only when `matching_target` is `IP`. Leave unset to keep whatever the controller holds -- setting it wrong reverses the rule rather than disabling it.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/boolplanmodifier"
                            }
                          ],
                          "schema_definition": "boolplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  },
                  "name": "match_opposite_ips"
                },
                {
                  "bool": {
                    "computed_optional_required": "computed_optional",
                    "description": "INVERT the network match: the policy matches every network EXCEPT those in `network_ids`. Meaningful only when `matching_target` selects networks.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/boolplanmodifier"
                            }
                          ],
                          "schema_definition": "boolplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  },
                  "name": "match_opposite_networks"
                },
                {
                  "bool": {
                    "computed_optional_required": "computed_optional",
                    "description": "INVERT the port match: the policy matches every port EXCEPT those in `port` or `port_group_id`. Meaningful only when `port_matching_type` selects specific ports.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/boolplanmodifier"
                            }
                          ],
                          "schema_definition": "boolplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  },
                  "name": "match_opposite_ports"
                },
                {
                  "name": "matching_target",
                  "string": {
                    "computed_optional_required": "required",
                    "description": "What to match: `ANY`, `NETWORK`, `CLIENT`, `IP`, `DEVICE`, `MAC`, or `WEB` (domains/FQDN).",
                    "validators": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                            }
                          ],
                          "schema_definition": "stringvalidator.OneOf(\"ANY\", \"NETWORK\", \"CLIENT\", \"IP\", \"DEVICE\", \"MAC\", \"WEB\")"
                        }
                      }
                    ]
                  }
                },
                {
                  "name": "matching_target_type",
                  "string": {
                    "computed_optional_required": "computed",
                    "description": "How the matching target is specified (`ANY`, `SPECIFIC`, `LIST`, `OBJECT`). Managed by the UniFi controller; the provider round-trips it so updates are accepted.",
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                            }
                          ],
                          "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  }
                },
                {
                  "list": {
                    "computed_optional_required": "computed_optional",
                    "description": "List of UniFi network IDs to match. Used when `matching_target` is `NETWORK`.",
                    "element_type": {
                      "string": {}
                    },
                    "plan_modifiers": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/listplanmodifier"
                            }
                          ],
                          "schema_definition": "listplanmodifier.UseStateForUnknown()"
                        }
                      }
                    ]
                  },
                  "name": "network_ids"
                },
                {
                  "name": "port",
                  "string": {
                    "computed_optional_required": "computed_optional",
                    "description": "Port(s) to match when `port_matching_type` is `SPECIFIC`. A single port (`161`) or a comma-separated list of ports/ranges (`80,443`, `8000-8100`). Leave unset for no port match.",
                    "validators": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "regexp"
                            },
