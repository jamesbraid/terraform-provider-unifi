{
  "version": "0.1",
  "provider": {
    "name": "unifi"
  },
  "resources": [
    {
      "name": "vpn_client",
      "schema": {
        "attributes": [
          {
            "bool": {
              "computed_optional_required": "computed_optional",
              "default": {
                "static": false
              },
              "description": "Specifies whether to use the VPN as the default route."
            },
            "name": "default_route"
          },
          {
            "bool": {
              "computed_optional_required": "computed_optional",
              "default": {
                "static": true
              },
              "description": "Specifies whether the VPN client is enabled."
            },
            "name": "enabled"
          },
          {
            "name": "id",
            "string": {
              "computed_optional_required": "computed",
              "description": "The ID of the VPN client.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "name",
            "string": {
              "computed_optional_required": "required",
              "description": "The name of the VPN client."
            }
          },
          {
            "bool": {
              "computed_optional_required": "computed_optional",
              "default": {
                "static": false
              },
              "description": "Specifies whether to pull DNS servers from the VPN."
            },
            "name": "pull_dns"
          },
          {
            "name": "site",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "The name of the site to associate the VPN client with.",
              "plan_modifiers": [
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.RequiresReplace()"
                  }
                },
                {
                  "custom": {
                    "imports": [
                      {
                        "path": "github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
                      }
                    ],
                    "schema_definition": "stringplanmodifier.UseStateForUnknown()"
                  }
                }
              ]
            }
          },
          {
            "name": "subnet",
            "string": {
              "computed_optional_required": "required",
              "custom_type": {
                "import": {
                  "path": "github.com/hashicorp/terraform-plugin-framework-nettypes/cidrtypes"
                },
                "type": "cidrtypes.IPv4PrefixType{}",
                "value_type": "cidrtypes.IPv4Prefix"
              },
              "description": "The local IP address for the WireGuard tunnel in CIDR notation (e.g., `10.0.0.2/24`)."
            }
          },
          {
            "name": "wireguard",
            "single_nested": {
              "attributes": [
                {
                  "name": "configuration",
                  "single_nested": {
                    "attributes": [
                      {
                        "name": "content",
                        "string": {
                          "computed_optional_required": "required",
                          "description": "Base64-encoded WireGuard configuration file content.",
                          "sensitive": true
                        }
                      },
                      {
                        "name": "filename",
                        "string": {
                          "computed_optional_required": "required",
                          "description": "Filename of the WireGuard configuration file."
                        }
                      }
                    ],
                    "computed_optional_required": "optional",
                    "description": "File-based WireGuard configuration. Provide a complete WireGuard .conf file."
                  }
                },
                {
                  "list": {
                    "computed_optional_required": "optional",
                    "description": "DNS servers for the WireGuard interface. Required for manual mode. Must specify 1-2 DNS server addresses.",
                    "element_type": {
                      "string": {}
                    },
                    "validators": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework-validators/listvalidator"
                            }
                          ],
                          "schema_definition": "listvalidator.SizeBetween(1, 2)"
                        }
                      }
                    ]
                  },
                  "name": "dns_servers"
                },
                {
                  "name": "interface",
                  "string": {
                    "computed_optional_required": "computed_optional",
                    "default": {
                      "static": "wan"
                    },
                    "description": "WAN interface to use for the VPN connection (e.g., `wan`, `wan2`).",
                    "validators": [
                      {
                        "custom": {
                          "imports": [
                            {
                              "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                            },
                            {
                              "path": "regexp"
                            }
                          ],
                          "schema_definition": "stringvalidator.RegexMatches(regexp.MustCompile(`^wan[2-9]?$`), \"must be 'wan' or 'wan2' through 'wan9'\")"
                        }
                      }
                    ]
                  }
                },
                {
                  "name": "peer",
                  "single_nested": {
                    "attributes": [
                      {
                        "name": "ip",
                        "string": {
                          "computed_optional_required": "required",
                          "description": "WireGuard peer endpoint IP address."
                        }
                      },
                      {
                        "int64": {
                          "computed_optional_required": "required",
                          "description": "WireGuard peer endpoint port.",
                          "validators": [
                            {
                              "custom": {
                                "imports": [
                                  {
                                    "path": "github.com/hashicorp/terraform-plugin-framework-validators/int64validator"
                                  }
                                ],
                                "schema_definition": "int64validator.Between(1, 65535)"
                              }
                            }
                          ]
                        },
                        "name": "port"
                      },
                      {
                        "name": "public_key",
                        "string": {
                          "computed_optional_required": "required",
                          "description": "WireGuard peer public key.",
                          "sensitive": true
                        }
                      }
                    ],
                    "computed_optional_required": "optional",
                    "description": "Manual WireGuard peer configuration. Specify peer endpoint and public key."
                  }
                },
                {
                  "name": "preshared_key",
                  "string": {
                    "computed_optional_required": "optional",
                    "description": "WireGuard preshared key. Required when preshared_key_enabled is true.",
                    "sensitive": true
                  }
                },
                {
                  "bool": {
                    "computed_optional_required": "computed_optional",
                    "default": {
                      "static": false
                    },
                    "description": "Specifies whether to use a preshared key for additional security."
                  },
                  "name": "preshared_key_enabled"
                },
                {
                  "name": "private_key",
                  "string": {
                    "computed_optional_required": "required",
                    "description": "WireGuard private key for this client.",
                    "sensitive": true
                  }
                }
              ],
              "computed_optional_required": "required",
              "description": "WireGuard VPN configuration. Specify either `configuration` for file upload mode or `peer` for manual configuration."
            }
          }
        ],
        "markdown_description": "`unifi_vpn_client` manages WireGuard VPN client connections in the UniFi controller."
      }
    }
  ]
}
