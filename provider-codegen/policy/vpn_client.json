  "format_version": 1,
  "generator_name": "vpn_client",
  "groupings": [
    {
      "attribute": {
        "computed_optional_required": "required",
        "description": "WireGuard VPN configuration. Specify either `configuration` for file upload mode or `peer` for manual configuration."
      },
      "members": [
        {
          "attribute": {
            "computed_optional_required": "required",
            "description": "WireGuard private key for this client.",
            "sensitive": true
          },
          "disposition": "managed",
          "structural_name": "x_wireguard_private_key",
          "terraform_name": "private_key"
        },
        {
          "attribute": {
            "computed_optional_required": "computed_optional",
            "default": {
              "static": "wan"
            },
            "description": "WAN interface to use for the VPN connection (e.g., `wan`, `wan2`).",
            "validators": [
              {
                "custom": {
                  "imports": [
                    {
                      "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                    },
                    {
                      "path": "regexp"
                    }
                  ],
                  "schema_definition": "stringvalidator.RegexMatches(regexp.MustCompile(`^wan[2-9]?$`), \"must be 'wan' or 'wan2' through 'wan9'\")"
                }
              }
            ]
          },
          "disposition": "managed",
          "structural_name": "wireguard_interface",
          "terraform_name": "interface"
        },
        {
          "attribute": {
            "computed_optional_required": "optional",
            "description": "WireGuard preshared key. Required when preshared_key_enabled is true.",
            "sensitive": true
          },
          "disposition": "managed",
          "structural_name": "wireguard_client_preshared_key",
          "terraform_name": "preshared_key"
        },
        {
          "attribute": {
            "computed_optional_required": "computed_optional",
            "default": {
              "static": false
            },
            "description": "Specifies whether to use a preshared key for additional security."
          },
          "disposition": "managed",
          "structural_name": "wireguard_client_preshared_key_enabled",
          "terraform_name": "preshared_key_enabled"
        },
        {
          "attribute": {
            "computed_optional_required": "optional",
            "description": "DNS servers for the WireGuard interface. Required for manual mode. Must specify 1-2 DNS server addresses.",
            "element_type": {
              "string": {}
            },
            "validators": [
              {
                "custom": {
                  "imports": [
                    {
                      "path": "github.com/hashicorp/terraform-plugin-framework-validators/listvalidator"
                    }
                  ],
                  "schema_definition": "listvalidator.SizeBetween(1, 2)"
                }
              }
            ]
          },
          "disposition": "managed",
          "terraform_name": "dns_servers",
          "terraform_type": "list"
        },
        {
          "attribute": {
            "attributes": [
              {
                "name": "ip",
                "string": {
                  "computed_optional_required": "required",
                  "description": "WireGuard peer endpoint IP address."
                }
              },
              {
                "int64": {
                  "computed_optional_required": "required",
                  "description": "WireGuard peer endpoint port.",
                  "validators": [
                    {
                      "custom": {
                        "imports": [
                          {
                            "path": "github.com/hashicorp/terraform-plugin-framework-validators/int64validator"
                          }
                        ],
                        "schema_definition": "int64validator.Between(1, 65535)"
                      }
                    }
                  ]
                },
                "name": "port"
              },
              {
                "name": "public_key",
                "string": {
                  "computed_optional_required": "required",
                  "description": "WireGuard peer public key.",
                  "sensitive": true
                }
              }
            ],
            "computed_optional_required": "optional",
            "description": "Manual WireGuard peer configuration. Specify peer endpoint and public key."
          },
          "disposition": "managed",
          "terraform_name": "peer",
          "terraform_type": "single_nested"
        },
        {
          "attribute": {
            "attributes": [
              {
                "name": "content",
                "string": {
                  "computed_optional_required": "required",
                  "description": "Base64-encoded WireGuard configuration file content.",
                  "sensitive": true
                }
              },
              {
                "name": "filename",
                "string": {
                  "computed_optional_required": "required",
                  "description": "Filename of the WireGuard configuration file."
                }
              }
            ],
            "computed_optional_required": "optional",
            "description": "File-based WireGuard configuration. Provide a complete WireGuard .conf file."
          },
          "disposition": "managed",
          "invented": "an alternative input form rather than a projection: the controller's own file mode is not supported consistently across versions, so the provider parses the base64 .conf in content with parseWireGuardBase64Config and fills the peer fields from it. No wire field carries content or filename, and `peer` is the schema home for what the parse produces.",
          "terraform_name": "configuration",
          "terraform_type": "single_nested"
