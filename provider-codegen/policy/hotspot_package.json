  "resource": "unifi_hotspot_package",
  "generator_name": "hotspot_package",
  "source_specification_sha256": "6b1a906c7497968737a13afe685359dc21c263ac9171dfc3f5951166f8d6b465",
  "description": "Manages a hotspot package: a guest-portal access plan, either a timed free trial or an hourly paid plan. The controller's sanitizer requires exactly one of `trial_duration_minutes` (free trial, `amount` zero) or `hours` (paid, `amount` non-zero) on every write, including a masked update that only touches an unrelated attribute -- so `trial_duration_minutes` is forced Required here and always joins the write mask. Only the free-trial branch is exercised by this resource today; the paid branch needs `trial_duration_minutes` absent, which a Required attribute cannot express.",
  "fields": [
    {
