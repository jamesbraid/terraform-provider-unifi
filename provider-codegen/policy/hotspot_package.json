      "terraform_name": "amount",
      "terraform_type": "float64",
      "disposition": "managed",
      "attribute": {
        "computed_optional_required": "optional",
        "description": "The price of the package. Zero (the default when unset) makes the package a free trial, priced by `trial_duration_minutes`; a non-zero amount prices it by the hour instead, through `hours`."
      }
    },
    {
      "structural_name": "charged_as",
